---
import Layout from "@layouts/Layout.astro"
import InnerHero from "@components/sections/InnerHero.astro"

const heroContent = {
    title: "Tools",
    description: ""
}

---

<Layout title="Verbal Autopsy Tools" description="Find DigitVA, WHO verbal autopsy resources, mobile collection guidance, and training links.">
 <InnerHero content={heroContent} />
 <!-- Breadcrumb -->
  <nav class="bg-gray-100 border-b border-gray-300">
    <div class="max-w-5xl mx-auto px-4 py-2 text-sm text-gray-600">
      <a href="/" class="text-blue-700 hover:underline">Home</a> &gt; 
      <span>Tools</span>
    </div>
  </nav>
 <section class="py-16 bg-gray-50">
  <div class="max-w-5xl mx-auto px-6 md:px-10">
    <div class="space-y-12 text-gray-800 leading-relaxed">
      
      <h2 class="text-2xl font-semibold">Tools for verbal autopsy teams</h2>
      <p>Use these resources to collect interviews, support physician coding, and prepare your team.</p>
      <ul class="space-y-6">
        <li><h3 class="text-xl font-semibold"><a href="/digitva" class="underline">DigitVA platform</a></h3><p>Learn about digital interviews, case management, physician coding, and reporting.</p></li>
        <li><h3 class="text-xl font-semibold"><a href="https://digitvav3.causeofdeathindia.com/help/mobile-app" target="_blank" rel="noopener noreferrer" class="underline">DigitVA mobile app and setup</a></h3><p>Find Android downloads and guidance for offline interview collection.</p></li>
        <li><h3 class="text-xl font-semibold"><a href="https://digitvav3.causeofdeathindia.com/help" target="_blank" rel="noopener noreferrer" class="underline">DigitVA help centre</a></h3><p>Browse instructions for collection, coding, user roles, and getting started.</p></li>
        <li><h3 class="text-xl font-semibold"><a href="/guidelines" class="underline">Guidelines and manuals</a></h3><p>Access the supervisor manual and supporting verbal autopsy resources.</p></li>
        <li><h3 class="text-xl font-semibold"><a href="/process" class="underline">Training and certification</a></h3><p>Learn how to express interest in joining as a verbal autopsy coder.</p></li>
      </ul>
    </div>
  </div>
</section>
</Layout>

