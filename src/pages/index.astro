---
import Layout from '@layouts/Layout.astro';
import Hero from '@components/sections/Hero.astro';
import Features from '@components/sections/Features.astro';
import { featureLists } from '@data/features';
import RecentPosts from '@components/sections/RecentPosts.astro';
import heroImage from '../assets/images/home/default-hero-2.jpg';

const seoTitle = "MINErVA Network India | Mortality in India Through Verbal Autopsies";
const seoDescription = "MINErVA Network India strengthens cause-of-death ascertainment using standardized verbal autopsies to improve mortality data and public health insights across India.";

const heroContent = {
    title: 'Mortality in India established through verbal autopsies (MINErVA)',
    description: '',
    buttons: [
        
    ],
    backgroundImage: heroImage,
    overlayOpacity: 0
}

const featuresSection = {
    title: "Why Cause of Death Data Matters",
    description: "Every life matters, and every death tells a story. Cause of Death India platform is a collaborative approach to strengthen the cause of death ascertainment system through verbal autopsies in India. It is developed by the MINErVA network.",
    features: featureLists.main.features,
    
}


const recentPostsSection = {
    eyebrow: "Recent Posts",
    title: " ",
    description: "",
    button: {
            text: "View All Posts",
            link: "/blog",
            variant: "primary" as const
    }
}
---

<Layout title={seoTitle} description={seoDescription}>
<Hero content={heroContent} />
<Features content={featuresSection} padding="small" background="light" />
<section class="bg-background-light text-body-base px-4 py-12" aria-labelledby="digitva-introduction">
    <div class="max-w-5xl mx-auto flex flex-col md:flex-row md:items-center gap-8">
        <div class="flex-1">
            <h2 id="digitva-introduction" class="text-headline mb-4">Introducing DigitVA</h2>
            <p class="leading-relaxed">Discover a digital workflow for verbal autopsy interviews, physician coding, and mortality reporting.</p>
        </div>
        <a href="/digitva" class="inline-flex justify-center rounded-md bg-primary px-6 py-3 text-white font-medium hover:bg-primary-dark focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary">Learn about DigitVA</a>
    </div>
</section>
<RecentPosts content={recentPostsSection} background="base" padding="small" postsToShow={3} />
</Layout>
